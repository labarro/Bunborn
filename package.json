{
  "name": "bunborn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --port 8787",
    "build": "node scripts/build-schema.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check:models": "node scripts/check-models.mjs",
    "test:gemini": "node scripts/smoke-gemini.mjs",
    "format": "prettier --write src worker shared tests scripts *.ts *.md *.json *.jsonc",
    "format:check": "prettier --check src worker shared tests scripts *.ts *.md *.json *.jsonc"
  },
  "dependencies": {
    "@types/d3-force": "3.0.10",
    "d3-force": "3.0.0",
    "lucide-react": "^0.468.0",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
